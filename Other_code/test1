import sys
from PyQt5.QtWidgets import QApplication, QWidget, QVBoxLayout
from PyQt5.QtGui import QPainter, QColor, QBrush, QTextDocument
from PyQt5.QtCore import Qt, QRectF

class KPICardWidget(QWidget):
    def __init__(self, label="MTTR", current=45.0, previous=60.0, parent=None):
        super().__init__(parent)
        self.label = label
        self.current = current
        self.previous = previous
        self.setFixedSize(250, 140) # Kích thước thẻ KPI mẫu

    # Hàm chuyển đổi định dạng thời gian của bạn
    def change_time_format(self, value_in_minutes, mode='m'):
        # Giả lập logic chuyển đổi format thời gian của bạn
        hrs = int(value_in_minutes // 60)
        mins = int(value_in_minutes % 60)
        secs = int((value_in_minutes * 60) % 60)
        return {'h': hrs, 'm': mins, 's': secs}

    # Giữ nguyên hàm logic HTML của bạn (chỉ thêm self)
    def make_comparison_html(self, current: float, previous: float, label: str) -> str:
        diff = current - previous
        diff = round(diff, 1)
        if diff > 0:
            arrow = "&#9650;"   # ▲
            color = "#27ae60"   # green
            color_dt = "#e74c3c"
            sign = "+"
        elif diff < 0:
            arrow = "&#9660;"   # ▼
            color = "#e74c3c"   # red
            color_dt = "#27ae60"
            sign = ""
        else:
            arrow = "&#9654;"   # ►
            color = "#888888"   # grey
            color_dt = "#888888"
            sign = ""
            
        if label in ["MTTR", "MTBF"]:
            percent = (1-current/previous) if previous != 0 else 0
            time_format = self.change_time_format(previous, 'm')
            return f"""
            <div style='font-family: Arial; text-align: center;'>
                <span style='font-size: 11px; font-weight: bold; color: #222;'>Previous:</span>
                <span style='font-size: 14px; font-weight: bold; color: #222;'>
                    {f"{time_format['h']} hrs {time_format['m']} mins" if previous >= 60 else f"{time_format['m']} mins {time_format['s']} secs"}
                </span>
                <br/>
                <span style='font-size: 12px; color: {color_dt if label == "MTTR" else color}; font-weight: bold;'>
                    {arrow} {"-" if percent > 0 else "+"}{abs(percent*100):.1f}% vs prev
                </span>
            </div>
            """
        else:
            return f"""
            <div style='font-family: Arial; text-align: center;'>
                <span style='font-size: 11px; font-weight: bold; color: #222;'>Previous:</span>
                <span style='font-size: 14px; font-weight: bold; color: #222;'>{previous:.1f}%</span>
                <br/>
                <span style='font-size: 12px; color: {color}; font-weight: bold;'>
                    {arrow} {sign}{diff:.1f}% vs prev
                </span>
            </div>
            """

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        # 1. Vẽ nền Card bằng QPainter (Ví dụ: Thẻ màu trắng bo góc)
        painter.setPen(Qt.NoPen)
        painter.setBrush(QBrush(QColor("#FFFFFF")))
        painter.drawRoundedRect(self.rect(), 15, 15)

        # Vẽ tiêu đề tĩnh hoặc giá trị Current bằng Painter nếu muốn
        painter.setPen(QColor("#555555"))
        painter.drawText(20, 30, f"{self.label} (Current: {self.current})")

        # 2. LẤY CHUỖI HTML TỪ HÀM CỦA BẠN VÀ RENDER LÊN WIDGET
        html_content = self.make_comparison_html(self.current, self.previous, self.label)
        
        doc = QTextDocument()
        doc.setHtml(html_content)
        # Đặt độ rộng cố định cho khối HTML để canh lề 'text-align: center' hoạt động chính xác
        doc.setTextWidth(self.width() - 40) 

        # 3. Dịch chuyển Painter đến vị trí bạn muốn đặt cụm HTML trên Card
        # Ví dụ: đẩy cụm so sánh này xuống nửa dưới của thẻ (x=20, y=70)
        painter.save()
        painter.translate(20, 70)
        
        # Tiến hành vẽ tài liệu HTML lên widget thông qua Painter
        doc.drawContents(painter)
        painter.restore()

        painter.end()

# --- Chạy kiểm tra thử giao diện ---
if __name__ == "__main__":
    app = QApplication(sys.argv)
    
    main_win = QWidget()
    main_win.setWindowTitle("Test Render HTML inside QPainter")
    main_win.setStyleSheet("background-color: #EFEFEF;") # Nền xám cho nổi bật Card trắng
    
    layout = QVBoxLayout(main_win)
    
    # Test thử 1 thẻ MTTR (Giảm thời gian sửa chữa -> Hiển thị phần trăm màu XANH LÁ nhờ logic color_dt của bạn)
    card_mttr = KPICardWidget(label="MTTR", current=45.0, previous=60.0)
    layout.addWidget(card_mttr)
    
    main_win.show()
    sys.exit(app.exec_())