final_df = pd.DataFrame(columns=["Line Name", "Model Name", "Lot no", "Date", "Shift", "Total"])
for month in ["Mar", "Apr", "May"]:
  for part in ["1", "2"]:
    file_name = f"Kha_ML26_{month}_{part}.xlsx"
    file_path = os.path.join(PROJECT_ROOT, 'exported_files', file_name)
    if os.path.exists(file_path):
        df_existing = pd.read_excel(file_path)
        df_existing.drop(columns=["Production Date"], inplace=True)
        df_existing = (
            df_existing.groupby(["Line Name", "Model Name", "Lot no"], as_index=False)
                       .agg({"Total": "sum"})
        )
        df_temp = df_existing.copy()
        df_temp["year"] = df_existing["Lot no"].str[0].astype(int) + 2020
        df_temp["month"] = df_existing["Lot no"].str[1].astype(str)
        df_temp["day"] = df_existing["Lot no"].str[2:4].astype(int)
        df_temp["shift"] = df_existing["Lot no"].str[5].astype(str)
        df_temp["month"] = df_temp["month"].replace({"X": "10", "Y": "11", "Z": "12"})
        df_temp["Date"] = pd.to_datetime(df_temp[["year", "month", "day"]])
        df_temp["Date"] = df_temp["Date"].dt.strftime("%Y-%m-%d")
        df_temp.drop(columns=["year", "month", "day"], inplace=True)
        df_temp["Shift"] = df_temp["Lot no"].str[4:6]
        df_temp["Lot no"] = df_temp["Lot no"].str[0:4]
        df_final = df_temp[["Line Name", "Model Name", "Lot no", "Date", "Shift", "Total"]]
        df_final =df_final.groupby(["Line Name", "Model Name", "Lot no", "Date"], as_index=False).agg({"Total": "sum", "Shift": lambda x: ",".join(x.unique()) })
        final_df = pd.concat([final_df, df_final], ignore_index=True)
output_file_name = "Kha_ML26_grouped.xlsx"
output_file_path = os.path.join(PROJECT_ROOT, 'exported_files', output_file_name)
final_df.to_excel(output_file_path, index=False)
