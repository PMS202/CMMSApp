import sys
from PyQt5 import QtWidgets, QtCore, QtGui

class MonthYearPicker(QtWidgets.QDateEdit):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        
        # 1. Định dạng chỉ hiển thị Tháng và Năm
        self.setDisplayFormat("MMM-yyyy")
        self.setCalendarPopup(True)
        self.setDate(QtCore.QDate.currentDate())

        # 2. Lấy đối tượng Calendar và tùy biến
        self.cal = self.calendarWidget()
        
        # Ẩn bảng ngày bên dưới
        table_view = self.cal.findChild(QtWidgets.QTableView)
        if table_view:
            table_view.hide()

        # 3. Ép kích thước Popup chỉ vừa bằng thanh tiêu đề (Thanh màu xanh)
        # Thông thường thanh này cao khoảng 40-50px
        self.cal.setFixedSize(250, 45) 

        # 4. Cập nhật giá trị ngay khi bấm mũi tên chuyển tháng/năm
        self.cal.currentPageChanged.connect(self.update_date_from_calendar)

        # 5. Style Sheet để giống hình mẫu của bạn
        self.cal.setStyleSheet("""
            QCalendarWidget QWidget#qt_calendar_navigationbar {
                background-color: #0066cc; /* Màu xanh nền */
            }
            QCalendarWidget QToolButton {
                color: white;
                font-weight: bold;
                background-color: transparent;
            }
        """)

    def update_date_from_calendar(self, year, month):
        # Khi người dùng bấm mũi tên, cập nhật lại ngày vào QDateEdit
        # Ta lấy ngày 1 của tháng đó làm mặc định
        new_date = QtCore.QDate(year, month, 1)
        self.setDate(new_date)

# --- Chạy thử ứng dụng ---
if __name__ == "__main__":
    app = QtWidgets.QApplication(sys.argv)
    
    window = QtWidgets.QWidget()
    window.setWindowTitle("Month Year Only")
    layout = QtWidgets.QVBoxLayout(window)

    picker = MonthYearPicker()
    layout.addWidget(picker)
    layout.addWidget(QtWidgets.QLabel("Widget này đã ẩn hoàn toàn bảng chọn ngày."))

    window.resize(300, 100)
    window.show()
    sys.exit(app.exec_())