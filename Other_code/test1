import sys
from PyQt5.QtWidgets import QApplication, QMainWindow, QVBoxLayout, QWidget
import pyqtgraph as pg

class ChartWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Giám sát dữ liệu sản xuất")
        
        # 1. Tạo widget biểu đồ
        self.plot_graph = pg.PlotWidget()
        self.setCentralWidget(self.plot_graph)
        
        # 2. Cấu hình màu nền và tiêu đề
        self.plot_graph.setBackground('w') # 'w' là màu trắng
        self.plot_graph.setTitle("Biểu đồ hiệu suất", color="b", size="15pt")
        
        # 3. Vẽ dữ liệu
        hour = [1, 2, 3, 4, 5, 6, 7, 8]
        output = [10, 15, 12, 18, 20, 15, 25, 22]
        
        # Tạo bút vẽ (Pen) - tương đương QPen bạn đã biết
        pen = pg.mkPen(color=(255, 0, 0), width=3) 
        
        self.plot_graph.plot(hour, output, pen=pen, symbol='o')

app = QApplication(sys.argv)
win = ChartWindow()
win.show()
sys.exit(app.exec_())