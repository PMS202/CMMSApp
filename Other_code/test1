import sys
from PyQt5.QtWidgets import QApplication, QWidget, QVBoxLayout, QLineEdit, QLabel, QHBoxLayout
from PyQt5.QtCore import Qt

class SuffixLineEdit(QLineEdit):
    def __init__(self, suffix_text="", parent=None):
        super().__init__(parent)
        
        # 1. Tạo một QLabel nằm NGAY TRONG ô nhập liệu
        self.suffix_label = QLabel(suffix_text, self)
        # Đặt màu xám mờ cho giống một cái nhãn phụ đơn vị
        self.suffix_label.setStyleSheet("color: #888888; background: transparent;") 
        
        # 2. Dùng layout để ép nhãn này luôn dính về góc bên phải
        internal_layout = QHBoxLayout(self)
        internal_layout.addStretch()  # Thanh lò xo đẩy label sang phải
        internal_layout.addWidget(self.suffix_label)
        
        # Căn chỉnh lề nội bộ (cách mép phải 10px, trên dưới 0px)
        internal_layout.setContentsMargins(0, 0, 10, 0)
        internal_layout.setAlignment(Qt.AlignVCenter)
        
        # Đặt chữ hậu tố ban đầu
        if suffix_text:
            self.setSuffix(suffix_text)

    def setSuffix(self, text):
        """Hàm để thay đổi chữ hậu tố động nếu cần"""
        self.suffix_label.setText(text)
        self.suffix_label.adjustSize() # Ép nhãn tính toán lại kích thước chuẩn
        
        # MẸO QUAN TRỌNG: Tạo một vùng đệm bên phải (Text Margin) cho ô nhập liệu.
        # Vùng đệm này bằng đúng độ rộng của chữ hậu tố + 15px khoảng cách.
        # Nhờ vậy, chữ bạn gõ sẽ bị chặn lại trước khi chạm vào chữ hậu tố.
        right_margin = self.suffix_label.width() + 15
        self.setTextMargins(0, 0, right_margin, 0)


# --- Giao diện chạy thử ---
class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Persistent Right Label")
        self.resize(350, 120)
        
        layout = QVBoxLayout(self)
        
        # Thử nghiệm với đơn vị tiền tệ
        self.input_money = SuffixLineEdit("VND")
        self.input_money.setPlaceholderText("Nhập số tiền...") # Vẫn dùng được placeholder gốc căn trái
        
        # Thử nghiệm với đơn vị phần trăm
        self.input_percent = SuffixLineEdit("%")
        self.input_percent.setPlaceholderText("Nhập tỉ lệ giảm giá...")
        
        layout.addWidget(self.input_money)
        layout.addWidget(self.input_percent)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.show()
    sys.exit(app.exec_())