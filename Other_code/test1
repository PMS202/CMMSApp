import sys
import numpy as np
from PyQt5 import QtWidgets
import pyqtgraph as pg

class HistogramDashboard(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Histogram Dashboard")

        # Main widget
        self.plot = pg.PlotWidget()
        self.setCentralWidget(self.plot)

        # Style
        self.plot.setBackground('w')
        self.plot.showGrid(x=True, y=True, alpha=0.3)

        # Axis label
        self.plot.setLabel('left', 'Frequency')
        self.plot.setLabel('bottom', 'Value')

        # Legend (horizontal)
        self.legend = self.plot.addLegend(colCount=1)

        # Generate sample data (ví dụ downtime)
        data = np.random.normal(loc=50, scale=15, size=1000)

        self.plot_histogram(data)

    def plot_histogram(self, data):
        # Tính histogram
        y, x = np.histogram(data, bins=20)

        # Vẽ dạng bar
        bg = pg.BarGraphItem(
            x=x[:-1],
            height=y,
            width=(x[1] - x[0]) * 0.8,
            brush=(100, 150, 255, 200)
        )

        self.plot.addItem(bg)

        # Legend (dùng dummy tròn cho đẹp)
        curve = self.plot.plot(
            [], [],
            pen=None,
            symbol='o',
            symbolSize=10,
            symbolBrush=(100, 150, 255),
            symbolPen=None
        )

        self.legend.addItem(curve, "Downtime Distribution")


if __name__ == "__main__":
    app = QtWidgets.QApplication(sys.argv)
    window = HistogramDashboard()
    window.resize(800, 500)
    window.show()
    sys.exit(app.exec_())